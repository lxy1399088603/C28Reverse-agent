{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Textual TUI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tui_app.py",
      "args": ["--inline"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "HTTP_PROXY": "http://127.0.0.1:10808",
        "HTTPS_PROXY": "http://127.0.0.1:10808"
      }
    }
  ]
}
